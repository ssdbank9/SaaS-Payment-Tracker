[Unit]
Description=Wasooli (Payments Tracker) - gunicorn on 127.0.0.1:8080
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=payments-tracker
Group=payments-tracker
WorkingDirectory=/opt/payments-tracker/server
EnvironmentFile=/etc/payments-tracker.env
ExecStart=/opt/payments-tracker/venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:8080 --timeout 180 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/payments-tracker

[Install]
WantedBy=multi-user.target
